<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional internet permission ONLY used when the student explicitly triggers the optional AI Study Assistant -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BsebStudyApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_bseb"
        android:roundIcon="@drawable/ic_launcher_bseb"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BSEBAIStudyEngine"
        tools:targetApi="34">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BSEBAIStudyEngine">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
